# Environment variables for the deployment package
# Do NOT commit real values to source control.

# Paperclip API key (required for Paperclip service)
PAPERCLIP_API_KEY=

# Qdrant API key (if using Qdrant Cloud, otherwise leave blank)
QDRANT_API_KEY=

# Firecrawl API key (for web scraping capabilities)
FIRECRAWL_API_KEY=

# OpenRouter API key (for LLM access)
OPENROUTER_API_KEY=

# PostgreSQL password for the Paperclip DB
POSTGRES_PASSWORD=paperclip

# Company identifier for Paperclip services
COMPANY_ID=6e74927d-7d02-4975-88e5-9b2e5c34146f
